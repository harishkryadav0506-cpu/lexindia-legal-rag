# =====================================================================
# LexIndia — Legal RAG System for Indian Tax Law Environment Configuration
# =====================================================================

# LLM Provider Configuration (groq | together | hf)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional secondary providers
TOGETHER_API_KEY=
HF_TOKEN=your_hf_token_here





# Model Roles (Configured via env, never hardcoded)
# GENERATION_MODEL: default "openai/gpt-oss-120b" on Groq (or llama-3.3-70b-versatile / similar active model)
GENERATION_MODEL=openai/gpt-oss-120b
# EXPANSION_MODEL: default "qwen/qwen3.8-27b" on Groq
EXPANSION_MODEL=qwen/qwen3.8-27b

# Fallback & Judge LLM (Google GenAI)
GEMINI_API_KEY=your_gemini_api_key_here
JUDGE_PRIMARY=gemini-2.5-flash

# Elasticsearch Configuration
ES_URL=http://localhost:9200
ES_INDEX=lexindia_corpus

# Observability (Optional: Langfuse / Phoenix)
ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Feature Flags
ENABLE_GST=false

# System & Checkpointing
REVIEWS_DB_PATH=data/reviews.db
FASTAPI_PORT=8000
FRONTEND_PORT=3000
